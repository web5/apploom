# AI 研发平台 —— 环境变量示例
# 复制为 .env 后填入真实 key（.env 已被 gitignore，不会提交）

# ===== LLM 网关（提示词调试闭环用）=====
# 当前 provider：deepseek | hunyuan
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 腾讯混元（用户指定模型 hy3，baseURL: tokenhub.tencentmaas.com）
HUNYUAN_API_KEY=
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# HUNYUAN_MODEL=hy3

# ===== 数据库（Postgres.app，本地无密码）=====
# DATABASE_URL="postgresql://geekwen@localhost:5432/ai_dev_platform?schema=public"

# ===== Redis（W7 异步任务队列 BullMQ）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== 代码生成门禁（codegen 产物的 install / tsc / build 校验）=====
# enforce（默认）：未通过则自动回喂修复，耗尽轮数后阶段失败；warn：仅记录告警；off：关闭
# CODEGEN_GATE=enforce
# CODEGEN_GATE_MAX_REPAIRS=2

# ===== LLM 网关容错 / 用量 / 阶段自动修复 =====
# LLM_TIMEOUT_MS=300000        单次请求超时（毫秒）
# LLM_MAX_RETRIES=2            429/5xx/网络错误/超时的自动重试次数（指数退避；流式已输出后不重试）
# LLM_STREAM_USAGE=1           流式请求 include_usage 拿真实 token 用量（deepseek 默认开，hunyuan 默认关；不支持时置 0，改为估算）
# STAGE_AUTO_REPAIRS=1         模型输出未通过 JSON/Zod 校验或被 max_tokens 截断时，自动回喂校验错误重新生成的轮数
# ---- API 安全 ----
# API_KEYS=web:sk-xxx,ci:sk-yyy   启用 API Key 认证（名字:密钥，逗号分隔）。不设 = 不认证（仅限本机开发）
# AUTH_REQUIRED=1              没配 API_KEYS 就拒绝启动，防止生产环境漏配导致 API 全开
# API_KEY=sk-xxx               （apps/web 的服务端环境变量）Studio 经 /api 代理访问后端时由中间件注入，不会进浏览器
# CORS_ORIGINS=https://studio.example.com   允许的跨域来源（逗号分隔）；默认只放行 http://localhost:3000
# RATE_LIMIT_PER_MIN=240       每个密钥（未认证时每个 IP）每分钟请求数；RATE_LIMIT_CREATE_PER_MIN=10 为创建流水线的额度；0 = 不限
# ---- 沙箱（执行 LLM 生成代码：install / build / dev server）----
# SANDBOX_MODE=auto            auto（支持则启用 OS 级隔离，不支持告警并退化）| seatbelt（强制，不可用则拒绝执行；多用户/生产用）| off
# SANDBOX_ENV_ALLOW=NPM_TOKEN  额外放行给子进程的环境变量名（逗号分隔）；默认只带 PATH/LANG/代理/registry
# SANDBOX_READ_ALLOW=/path     沙箱内额外可读的目录（冒号分隔），如家目录里的 pnpm/yarn 安装位置
# SANDBOX_DENY_PORTS=9200      沙箱内禁止连接的额外端口（Redis/数据库/API 端口已默认禁止）
# SANDBOX_HOME=/tmp/apploom-sandbox-home   沙箱进程的 HOME（含 npm 缓存）
# 注意：启动环境里不要放密钥（同用户进程能读到启动环境快照）；用 `pnpm --filter api start:clean` 启动，密钥放 .env
# LLM_MAX_TOKENS_CEILING=16384  截断自愈放大输出上限时的封顶值（每次截断翻倍）。DeepSeek 官方 API 上限 8192，用它时请设为 8192，否则服务端 400

# ===== 预算与备用模型 =====
# PIPELINE_TOKEN_BUDGET=500000   单条流水线累计 token 上限（含重试/修复/门禁回喂），0 = 不限制；超限阶段以 budget 错误失败
# LLM_FALLBACK_PROVIDER=hunyuan  主模型 5xx/超时/网络错误重试耗尽后切换的备用 provider（需配对应 API key；默认不启用）

# ===== 人工审批 HITL（高风险操作：终止非 AppLoom 进程、可疑命令、可疑启动命令）=====
# HITL_MODE=ask            ask（默认，挂起等人审批）| auto（不再询问一律放行，破坏性命令仍拒绝）| deny（需审批的一律拒绝）
# HITL_TIMEOUT_MS=300000   审批等待上限，超时视为拒绝；等待期间占用 worker，不宜过长

# ===== 阶段产物文件 =====
# APPLOOM_ARTIFACT_DIR=/tmp/apploom-artifacts   原型完整 HTML 等大产物另存为文件的目录（{docId}/prototype.html）

# ===== 附加请求体（按服务商开关特性）=====
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   合并进主模型的请求体（JSON 对象）。推理模型（如 TokenHub 上的 deepseek-v4-flash）
#   会把 max_tokens 耗在推理上导致正文为空/被截断，结构化 JSON 输出建议关闭推理；model/messages/stream 不可被覆盖，备用模型不受影响

# AI 研发平台 —— 环境变量示例
# 复制为 .env 后填入真实 key（.env 已被 gitignore，不会提交）

# ===== LLM 网关（提示词调试闭环用）=====
# 当前 provider：deepseek | hunyuan
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 腾讯混元（用户指定模型 hy3）
HUNYUAN_API_KEY=
# HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# HUNYUAN_MODEL=hy3

# ===== 数据库（Postgres.app，本地无密码）=====

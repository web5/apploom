# AI 研发平台 —— 环境变量示例
# 复制为 .env 后填入真实 key（.env 已被 gitignore，不会提交）

# ===== LLM 网关（提示词调试闭环用）=====
# 当前 provider：deepseek | hunyuan
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 腾讯混元（用户指定模型 hy3，baseURL: tokenhub.tencentmaas.com）
HUNYUAN_API_KEY=
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# HUNYUAN_MODEL=hy3

# ===== 数据库（Postgres.app，本地无密码）=====
# DATABASE_URL="postgresql://geekwen@localhost:5432/ai_dev_platform?schema=public"

# ===== Redis（W7 异步任务队列 BullMQ）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== 代码生成门禁（codegen 产物的 install / tsc / build 校验）=====
# enforce（默认）：未通过则自动回喂修复，耗尽轮数后阶段失败；warn：仅记录告警；off：关闭
# CODEGEN_GATE=enforce
# CODEGEN_GATE_MAX_REPAIRS=2

# ===== LLM 网关容错 / 用量 / 阶段自动修复 =====
# LLM_TIMEOUT_MS=300000        单次请求超时（毫秒）
# LLM_MAX_RETRIES=2            429/5xx/网络错误/超时的自动重试次数（指数退避；流式已输出后不重试）
# LLM_STREAM_USAGE=1           流式请求 include_usage 拿真实 token 用量（deepseek 默认开，hunyuan 默认关；不支持时置 0，改为估算）
# STAGE_AUTO_REPAIRS=1         模型输出未通过 JSON/Zod 校验时，自动回喂校验错误重新生成的轮数

# ===== 预算与备用模型 =====
# PIPELINE_TOKEN_BUDGET=500000   单条流水线累计 token 上限（含重试/修复/门禁回喂），0 = 不限制；超限阶段以 budget 错误失败
# LLM_FALLBACK_PROVIDER=hunyuan  主模型 5xx/超时/网络错误重试耗尽后切换的备用 provider（需配对应 API key；默认不启用）

# ===== 人工审批 HITL（高风险操作：终止非 AppLoom 进程、可疑命令、可疑启动命令）=====
# HITL_MODE=ask            ask（默认，挂起等人审批）| auto（不再询问一律放行，破坏性命令仍拒绝）| deny（需审批的一律拒绝）
# HITL_TIMEOUT_MS=300000   审批等待上限，超时视为拒绝；等待期间占用 worker，不宜过长

# ===== 阶段产物文件 =====
# APPLOOM_ARTIFACT_DIR=/tmp/apploom-artifacts   原型完整 HTML 等大产物另存为文件的目录（{docId}/prototype.html）
